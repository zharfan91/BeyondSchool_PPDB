# Database
DATABASE_URL="mysql://root:password@localhost:3306/beyond_school_ppdb"

# Better Auth
BETTER_AUTH_SECRET="change-me-to-a-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_NAME="Beyond School PPDB"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email (SMTP) — optional. Without these, password-reset emails are just logged to the server console.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Beyond School PPDB <no-reply@beyondschool.sch.id>"

# Payment gateway (Midtrans Snap). Get keys from the Midtrans dashboard
# (Settings → Access Keys). Set the webhook/notification URL there to:
#   <your-app-url>/api/payments/webhook
#
# SIMULATION MODE: if MIDTRANS_SERVER_KEY is empty (as below), payment runs in
# a built-in simulation — the applicant picks a success/fail outcome instead of
# a real gateway popup. Fill the keys in to switch to real Midtrans
# automatically. Set PAYMENT_SIMULATION="true" to force simulation even when
# keys are present (e.g. for testing).
MIDTRANS_SERVER_KEY=""
MIDTRANS_IS_PRODUCTION="false"
PAYMENT_SIMULATION=""
# Client-side (exposed to the browser for the Snap popup):
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=""
# Sandbox: https://app.sandbox.midtrans.com/snap/snap.js
# Production: https://app.midtrans.com/snap/snap.js
NEXT_PUBLIC_MIDTRANS_SNAP_URL="https://app.sandbox.midtrans.com/snap/snap.js"
